# Backend base URL reachable from the phone (use your computer's LAN IP for physical devices).
# Leave empty in development to auto-use <metro-host>:8000.
EXPO_PUBLIC_SERVER_URL=
# Public web origin used for invite links (https://<domain>/r/CODE).
EXPO_PUBLIC_WEB_URL=
# Domain for universal links / app links (read by app.config.ts at build time).
IMPULSE_WEB_DOMAIN=
