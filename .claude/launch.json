{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "impulse-server",
      "runtimeExecutable": "server/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "server", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "impulse-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
