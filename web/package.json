{
  "name": "bluff-and-bonk-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:pages": "tsc --noEmit && VITE_OFFLINE=1 VITE_BASE=/bluff-and-bonk/ vite build && cp dist/index.html dist/404.html",
    "test": "tsx ../shared/test/transform.test.ts && tsx ../shared/test/parity.test.mts",
    "test:crossplay": "tsx ../shared/test/crossplay.test.mts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vite": "^8.0.0"
  }
}
